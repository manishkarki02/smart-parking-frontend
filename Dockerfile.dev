# ─── Development image ───────────────────────────────────────────────────────
# Runs the Vite dev server with hot reload.
# Source code is mounted via volume — no rebuild needed on file changes.
FROM node:22-alpine

# Enable corepack so pnpm is available
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy dependency files and install
# node_modules will be in the image layer (anonymous volume shadows host dir)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source (initial copy; live edits come from the bind-mount volume)
COPY . .

EXPOSE 5173

# --host binds to 0.0.0.0 so the container is reachable from the host machine
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]
